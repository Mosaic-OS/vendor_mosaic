package {
    default_applicable_licenses: ["mosaic-onnxruntime-license"],
}

license {
    name: "mosaic-onnxruntime-license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-MIT", "SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE", "ThirdPartyNotices.txt", "LICENSE-1DS"],
}

android_library_import {
    name: "mosaic-onnxruntime-android",
    aars: ["onnxruntime-android-1.31.0.aar"],
    extract_jni: true,
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "31",
}
